#!/bin/bash

CYAN='\033[0;36m'
BOLD='\033[1m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'

echo -e "${CYAN}${BOLD}=================================================="
echo -e "   🛡️  AUTOGUARD VPN CLIENT SETUP         "
echo -e "==================================================${NC}"

SERVER_IP="PLACEHOLDER-PUBLIC-IP"
INTERFACE_NAME="PLACEHOLDER-INTERFACE-NAME"
AUTH_KEY="PLACEHOLDER-AUTH_KEY"

# Everything the tunnel config needs is written in here by setup.sh rather than
# taken from the registration response. Only the assigned address comes over
# the network, and it has to fall inside SUBNET_PREFIX. A forged response
# therefore cannot point the tunnel at another server, swap the DNS server, or
# smuggle in a PostUp line -- which wg-quick would run as root.
SERVER_WG_KEY="PLACEHOLDER-SERVER-WG-KEY"
SERVER_WG_PORT="PLACEHOLDER-WG-PORT"
DNS_SERVER="PLACEHOLDER-DNS-SERVER"
SUBNET_PREFIX="PLACEHOLDER-SUBNET-PREFIX"

# Set by setup.sh from the certificate the server actually presents. "yes" for a
# CA-signed certificate: curl validates it normally. "no" for a self-signed one,
# which no CA vouches for: curl skips the CA and expiry checks but refuses any
# key other than TLS_PIN, the SHA-256 of this server's certificate key. An
# interceptor cannot present that key, and curl aborts before sending anything,
# so the token below only ever reaches this server.
VERIFY_TLS="PLACEHOLDER-VERIFY-TLS"
TLS_PIN="PLACEHOLDER-TLS-PIN"

error()       { echo -e "\n${RED}❌ ERROR: $1${NC}\n" >&2; exit 1; }
log_success() { echo -e "${GREEN}${BOLD}✅ $1${NC}"; }
log_warn()    { echo -e "${YELLOW}⚠️  $1${NC}"; }

# The VPN runs only while turned on: nothing starts it at boot. So there is
# never a moment where it looks on but is not yet protecting anything -- after
# a reboot it is plainly off until the user turns it on.
print_usage() {
    echo
    echo -e "${BOLD}The VPN stays on until you turn it off or restart. It does not start by itself.${NC}"
    echo -e "  Turn on:  ${CYAN}sudo wg-quick up ${INTERFACE_NAME}${NC}"
    echo -e "  Turn off: ${CYAN}sudo wg-quick down ${INTERFACE_NAME}${NC}"
    echo
    echo "While it is on, the kill switch blocks traffic that cannot go through the"
    echo "tunnel instead of letting it fall back to your normal connection -- LAN"
    echo "access included."
}

# Neither bring-up path can guarantee no kill switch rule was left behind: if
# wg-quick fails between installing the IPv4 and IPv6 rules, it removes the
# interface without running PreDown. The rules are not saved, so a restart
# always clears them.
UP_FAILED_HINT="If you have no internet now, a kill switch rule was left behind. Restart to
clear it, or see \"I lost all internet after the VPN dropped\" in the FAQ."

[ "$(id -u)" -eq 0 ] || error "Run this script with sudo."

command -v wg       >/dev/null 2>&1 || error "wireguard-tools not installed. Run: apt install wireguard-tools"
command -v curl     >/dev/null 2>&1 || error "curl not installed."
command -v python3  >/dev/null 2>&1 || error "python3 not installed."
command -v iptables >/dev/null 2>&1 || error "iptables not installed. Run: apt install iptables
It is needed for the kill switch, which blocks traffic outside the tunnel while the VPN is on."

# /proc/net/if_inet6 exists only when the kernel has IPv6. With v6 disabled,
# wg-quick dies trying to add the ::/0 route -- and nothing can leak over a
# stack that is not there, so the v6 half is left out instead of failing the
# install.
HAVE_IPV6="no"
[ -e /proc/net/if_inet6 ] && HAVE_IPV6="yes"

# The ::/0 route already blackholes IPv6 on its own; the ip6tables rule is the
# belt to its braces. Missing ip6tables is therefore a warning, not an error.
KILL_SWITCH_V6="no"
if [ "$HAVE_IPV6" = "yes" ]; then
    if command -v ip6tables >/dev/null 2>&1; then
        KILL_SWITCH_V6="yes"
    else
        log_warn "ip6tables not found — IPv6 is blackholed by routing, but without a kill switch rule."
    fi
fi

WG_CONF="/etc/wireguard/${INTERFACE_NAME}.conf"

# Earlier versions of this script enabled wg-quick@ so the tunnel came back at
# boot, which left a window after every boot where the machine was online but
# not yet protected. Undo that wherever it is still set.
if command -v systemctl >/dev/null 2>&1 \
   && systemctl is-enabled --quiet "wg-quick@${INTERFACE_NAME}" 2>/dev/null; then
    systemctl disable --quiet "wg-quick@${INTERFACE_NAME}" 2>/dev/null || true
    log_warn "Turned off starting the VPN at boot, which an earlier version of this script set up."
fi

if [ -f "$WG_CONF" ]; then
    if wg show "$INTERFACE_NAME" >/dev/null 2>&1; then
        log_success "The VPN is already on (interface ${INTERFACE_NAME})."
    else
        echo "Config already exists. Turning the VPN on..."
        wg-quick up "$INTERFACE_NAME" \
            || error "wg-quick up failed for the existing config at ${WG_CONF}.
${UP_FAILED_HINT}"
        log_success "The VPN is on (interface ${INTERFACE_NAME})."
    fi
    print_usage
    exit 0
fi

# Checked before anything talks to the server: a failure past registration
# leaves an address allocated that nothing will ever claim.
KEY_RE='^[A-Za-z0-9+/]{43}=$'
[[ $SERVER_WG_KEY =~ $KEY_RE ]] \
    || error "This script has no valid server key. Use the copy setup.sh generated in scripts/."

# An array rather than a string, so the empty case expands to no argument at
# all instead of an empty one.
CURL_TLS_OPTS=()
if [ "$VERIFY_TLS" = "no" ]; then
    [[ $TLS_PIN =~ $KEY_RE ]] \
        || error "This script has no valid certificate fingerprint. Use the copy setup.sh generated in scripts/."
    CURL_TLS_OPTS+=(-k --pinnedpubkey "sha256//${TLS_PIN}")
fi

echo "🔑 Generating WireGuard keypair..."
CLIENT_PRIVATE_KEY=$(wg genkey)
CLIENT_PUBLIC_KEY=$(echo "$CLIENT_PRIVATE_KEY" | wg pubkey)
log_success "Keypair generated."

echo "📡 Registering with VPN server at ${SERVER_IP}..."
RESPONSE=$(curl -sS --max-time 30 "${CURL_TLS_OPTS[@]}" \
    -X POST \
    -H "Content-Type: application/json" \
    -H "X-Auth-Token: ${AUTH_KEY}" \
    -d "{\"public_key\": \"${CLIENT_PUBLIC_KEY}\"}" \
    "https://${SERVER_IP}/addnewpeer")
CURL_EXIT=$?

case "$CURL_EXIT" in
    0) ;;
    90) error "The server presented a different certificate than the one this script was
generated for, so nothing was sent. Either something is intercepting the
connection, or the server's certificate changed (setup.sh --force, or a new
address). Get a freshly generated setupclient.sh from the server's scripts/." ;;
    6|7|28) error "Could not reach https://${SERVER_IP} (curl exit ${CURL_EXIT}).
Check TCP 443 is open to ${SERVER_IP} and that nginx_proxy is running on the server." ;;
    *) error "The registration request failed (curl exit ${CURL_EXIT})." ;;
esac

STATUS=$(echo "$RESPONSE" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('status',''))" 2>/dev/null)
[ "$STATUS" = "ok" ] || error "Server rejected registration. Response: $RESPONSE"

CLIENT_IP=$(echo "$RESPONSE" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('ip',''))" 2>/dev/null)

# The server only ever allocates .2 through .254 of its own /24.
valid_client_ip() {
    local last="${1##*.}"
    [ "${1%.*}" = "$SUBNET_PREFIX" ] || return 1
    [[ $last =~ ^[0-9]{1,3}$ ]] || return 1
    [ "$last" -ge 2 ] && [ "$last" -le 254 ]
}
valid_client_ip "$CLIENT_IP" \
    || error "Server assigned an address outside ${SUBNET_PREFIX}.0/24: '${CLIENT_IP}'"

ALLOWED_IPS="0.0.0.0/0, ::/0"
if [ "$HAVE_IPV6" = "no" ]; then
    ALLOWED_IPS="0.0.0.0/0"
    log_warn "IPv6 is disabled on this host — left out ::/0 so wg-quick can start."
fi

# Mirrors generate_client_config() in auth/helpers.py, which clients rendered
# before this script built its own config still rely on. Keep all copies in
# step; helpers.py lists them.
WG_CONFIG="[Interface]
PrivateKey = ${CLIENT_PRIVATE_KEY}
Address = ${CLIENT_IP}/32
DNS = ${DNS_SERVER}

[Peer]
PublicKey = ${SERVER_WG_KEY}
Endpoint = ${SERVER_IP}:${SERVER_WG_PORT}
AllowedIPs = ${ALLOWED_IPS}
PersistentKeepalive = 25"

# ---------------------------------------------------------------------------
# Kill switch
#
# wg-quick's own default routing is not one: it sends traffic through the
# tunnel while the interface exists, but if the interface disappears without a
# clean `wg-quick down`, the routes go with it and traffic silently falls back
# to the normal gateway. These OUTPUT rules stay installed until PreDown
# removes them, so losing the interface that way fails closed, while turning
# the VPN off with `wg-quick down` does not.
#
# The rules live in memory only and nothing starts the tunnel at boot, so after
# a restart the VPN is simply off and nothing is blocked until it is turned on.
#
# Both clauses are load-bearing. Handshake packets to the endpoint carry wg's
# own fwmark and are exempt -- without that the rule blocks the very tunnel it
# protects. --dst-type LOCAL exempts traffic to this machine's own addresses,
# loopback included -- without that it breaks local services, such as the
# systemd-resolved DNS stub on 127.0.0.53.
#
# The hooks are added here rather than server-side in generate_client_config()
# because WireGuard for Windows refuses configs containing PostUp/PreDown
# unless script execution is enabled in the registry -- shipping them from the
# server would break every Windows client.
# ---------------------------------------------------------------------------

# shellcheck disable=SC2016  # $(wg show ...) must reach the file literally; wg-quick expands it, not us.
HOOKS='PostUp = iptables -I OUTPUT ! -o %i -m mark ! --mark $(wg show %i fwmark) -m addrtype ! --dst-type LOCAL -j REJECT
PreDown = iptables -D OUTPUT ! -o %i -m mark ! --mark $(wg show %i fwmark) -m addrtype ! --dst-type LOCAL -j REJECT'

if [ "$KILL_SWITCH_V6" = "yes" ]; then
    # shellcheck disable=SC2016  # same as above.
    HOOKS="${HOOKS}
PostUp = ip6tables -I OUTPUT ! -o %i -m mark ! --mark \$(wg show %i fwmark) -m addrtype ! --dst-type LOCAL -j REJECT
PreDown = ip6tables -D OUTPUT ! -o %i -m mark ! --mark \$(wg show %i fwmark) -m addrtype ! --dst-type LOCAL -j REJECT"
fi

# Inserted directly after the [Interface] header: order within a section does
# not matter to wg-quick, and anchoring to the header avoids any assumption
# about which key happens to come last. Appending to the file instead would
# land these in [Peer], where they are not valid.
WG_CONFIG=$(printf '%s\n' "$WG_CONFIG" | awk -v hooks="$HOOKS" '
    { print }
    /^\[Interface\]/ && !inserted { print hooks; inserted = 1 }
')

mkdir -p /etc/wireguard
printf '%s\n' "$WG_CONFIG" > "$WG_CONF"
chmod 600 "$WG_CONF"
log_success "Config written to ${WG_CONF}."

echo "🚀 Starting WireGuard..."

# A bring-up that fails partway can leave the REJECT rules installed, which
# would take the user's internet down with it. Tear the interface back down if
# it is still there, which runs PreDown and removes them.
if ! wg-quick up "$INTERFACE_NAME"; then
    wg-quick down "$INTERFACE_NAME" >/dev/null 2>&1 || true
    error "wg-quick up failed, and the tunnel was torn back down.
${UP_FAILED_HINT}"
fi

log_success "Connected! The VPN is on (interface ${INTERFACE_NAME})."
print_usage
