#Requires -RunAsAdministrator

$ServerPublicIp = "PLACEHOLDER_SERVER_PUBLIC_IP"
$InterfaceName  = "PLACEHOLDER_INTERFACE_NAME"
$AuthKey        = "PLACEHOLDER_AUTH_KEY"

# Everything the tunnel config needs is written in here by setup.sh rather than
# taken from the registration response. Only the assigned address comes over
# the network, and it has to fall inside $SubnetPrefix. A forged response
# therefore cannot point the tunnel at another server or swap the DNS server.
$ServerWgKey    = "PLACEHOLDER_SERVER_WG_KEY"
$ServerWgPort   = "PLACEHOLDER_WG_PORT"
$DnsServer      = "PLACEHOLDER_DNS_SERVER"
$SubnetPrefix   = "PLACEHOLDER_SUBNET_PREFIX"

# Set by setup.sh from the certificate the server actually presents. A CA-signed
# certificate is validated normally. A self-signed one, which no CA vouches for,
# is pinned instead: the CA and expiry checks are skipped, but any key other
# than $TlsPin -- the SHA-256 of this server's certificate key -- is refused
# before anything is sent. An interceptor cannot present that key, so $AuthKey
# only ever reaches this server.
$VerifyTls = "PLACEHOLDER_VERIFY_TLS" -ne "no"
$TlsPin    = "PLACEHOLDER_TLS_PIN"

# The shape of a base64-encoded 32-byte value: a WireGuard key or a SHA-256.
$KeyPattern = '^[A-Za-z0-9+/]{43}=$'

$WgExe = "C:\Program Files\WireGuard\wg.exe"
$WgGui = "C:\Program Files\WireGuard\wireguard.exe"

# The manager service owns this directory, and it is the only place the GUI
# looks when it builds its tunnel list. A config installed from anywhere else
# still runs, but has no GUI entry -- which leaves the user with an always-on
# VPN and no way to switch it off.
$StoreDir = "C:\Program Files\WireGuard\Data\Configurations"

# Where earlier versions of this script wrote. Tunnels installed from there are
# the orphans described above; they get cleaned up on sight.
$LegacyDir = "C:\ProgramData\WireGuard"

if ($PSVersionTable.PSVersion.Major -lt 7) {
    # TLS 1.2 is not enabled by default on the .NET Framework that PowerShell
    # 5.1 runs on. This is about which protocol versions are offered, not about
    # trust.
    [System.Net.ServicePointManager]::SecurityProtocol = [System.Net.SecurityProtocolType]::Tls12
}

function CheckWireGuard {
    if (Test-Path $WgExe) { return }
    Write-Host "WireGuard not found. Installing via winget..." -ForegroundColor Yellow
    try {
        winget install -e --id WireGuard.WireGuard --silent --accept-package-agreements --accept-source-agreements
        if (!(Test-Path $WgExe)) { throw }
    } catch {
        Write-Host "Install failed. Download from https://www.wireguard.com/install/ and re-run." -ForegroundColor Red
        exit 1
    }
}

# The MSI lays down the binaries but does not create $StoreDir -- the manager
# service does that on its own first start. A silent install never launches the
# GUI, so on a fresh machine we get here before anything has started it and the
# store simply does not exist yet. That is the whole reason the first run used
# to fail and the second one succeeded: by then the service had come up on its
# own. Wait for it explicitly so a first run behaves like a second one.
function EnsureStore {
    if (Test-Path $StoreDir) { return }

    Write-Host "Waiting for the WireGuard manager to create its config store..." -ForegroundColor Cyan

    # winget returns as soon as the MSI reports success, which can be before
    # the service is registered. Wait for it to exist before starting it.
    for ($i = 0; $i -lt 15; $i++) {
        if (Get-Service WireGuardManager -ErrorAction SilentlyContinue) { break }
        Start-Sleep -Seconds 1
    }

    try { Start-Service WireGuardManager -ErrorAction Stop } catch { }

    for ($i = 0; $i -lt 30; $i++) {
        if (Test-Path $StoreDir) { return }
        Start-Sleep -Seconds 1
    }

    # Fallback: create it with the same SYSTEM/Administrators-only ACL the
    # manager applies. It re-reads the directory on its next start either way,
    # so this only has to be good enough to write into.
    New-Item -ItemType Directory -Path $StoreDir -Force | Out-Null
    icacls $StoreDir /inheritance:r /grant:r "SYSTEM:(OI)(CI)(F)" /grant:r "Administrators:(OI)(CI)(F)" | Out-Null

    if (-not (Test-Path $StoreDir)) {
        Write-Host "Could not create the WireGuard config store at $StoreDir" -ForegroundColor Red
        Write-Host "Open the WireGuard GUI once, then re-run this script." -ForegroundColor Yellow
        exit 1
    }
}

function ServiceNameFor($Name) { "WireGuardTunnel`$$Name" }

# Tunnels installed straight from a path outside the store are invisible to the
# GUI. Remove any this script created previously, so the user is not left with
# untoggleable services accumulating on every run.
function RemoveOrphanedTunnels {
    $orphans = Get-CimInstance Win32_Service -ErrorAction SilentlyContinue |
               Where-Object { $_.Name -like 'WireGuardTunnel$*' -and $_.PathName -like "*ProgramData\WireGuard*" }

    foreach ($svc in $orphans) {
        $tunnel = $svc.Name -replace '^WireGuardTunnel\$', ''
        Write-Host "Removing orphaned tunnel '$tunnel' (installed outside the GUI store)..." -ForegroundColor Yellow
        & $WgGui /uninstalltunnelservice $tunnel 2>$null
        Start-Sleep -Seconds 2
    }

    if (Test-Path $LegacyDir) {
        Get-ChildItem "$LegacyDir\*.conf" -ErrorAction SilentlyContinue |
            Remove-Item -Force -ErrorAction SilentlyContinue
    }
}

function StorePathFor($Name) {
    foreach ($ext in @("conf.dpapi", "conf")) {
        $p = Join-Path $StoreDir "$Name.$ext"
        if (Test-Path $p) { return $p }
    }
    return $null
}

function GenerateKeypair {
    $priv = & $WgExe genkey
    $pub  = $priv | & $WgExe pubkey
    @{ Private = $priv; Public = $pub }
}

# Checked before anything talks to the server: a failure past registration
# leaves an address allocated that nothing will ever claim.
function AssertRendered {
    if ($ServerWgKey -notmatch $KeyPattern) {
        Write-Host "This script has no valid server key. Use the copy setup.sh generated in scripts/." -ForegroundColor Red
        exit 1
    }
    if (-not $VerifyTls -and $TlsPin -notmatch $KeyPattern) {
        Write-Host "This script has no valid certificate fingerprint. Use the copy setup.sh generated in scripts/." -ForegroundColor Red
        exit 1
    }
}

function WriteUnreachableHint {
    Write-Host ""
    Write-Host "If the API was never reached at all, check TCP 443 is open to" -ForegroundColor Yellow
    Write-Host "$ServerPublicIp in your cloud firewall, and that nginx_proxy is running" -ForegroundColor Yellow
    Write-Host "on the server." -ForegroundColor Yellow
}

function RegisterPeer($PublicKey) {
    if ($VerifyTls) { return RegisterPeerValidated $PublicKey }
    return RegisterPeerPinned $PublicKey
}

# CA-signed server: validate against the Windows trust store like any other site.
function RegisterPeerValidated($PublicKey) {
    $body    = @{ public_key = $PublicKey } | ConvertTo-Json -Compress
    $headers = @{ "X-Auth-Token" = $AuthKey; "Content-Type" = "application/json" }
    $uri     = "https://$ServerPublicIp/addnewpeer"

    try { Invoke-RestMethod -Uri $uri -Method POST -Headers $headers -Body $body }
    catch {
        Write-Host "Registration failed: $_" -ForegroundColor Red
        WriteUnreachableHint
        exit 1
    }
}

# Self-signed server: pin its key. Invoke-RestMethod can only validate against
# the trust store or skip validation entirely -- it cannot accept one specific
# certificate and refuse every other. curl.exe can, and has shipped with
# Windows since 10 1803.
function RegisterPeerPinned($PublicKey) {
    $curl = Join-Path $env:SystemRoot "System32\curl.exe"
    if (-not (Test-Path $curl)) {
        Write-Host "curl.exe was not found at $curl. It ships with Windows 10 1803 and later." -ForegroundColor Red
        exit 1
    }

    # The body goes through a file rather than an argument, because Windows
    # PowerShell 5.1 strips the double quotes out of JSON passed to a native
    # command. It holds only the public key.
    $bodyFile = [System.IO.Path]::GetTempFileName()
    try {
        $body = @{ public_key = $PublicKey } | ConvertTo-Json -Compress
        [System.IO.File]::WriteAllText($bodyFile, $body, (New-Object System.Text.UTF8Encoding $false))

        $output = & $curl -sS --max-time 30 -k --pinnedpubkey "sha256//$TlsPin" `
            -X POST `
            -H "Content-Type: application/json" `
            -H "X-Auth-Token: $AuthKey" `
            --data-binary "@$bodyFile" `
            "https://$ServerPublicIp/addnewpeer"
        $exitCode = $LASTEXITCODE
    }
    finally {
        Remove-Item $bodyFile -Force -ErrorAction SilentlyContinue
    }

    if ($exitCode -eq 90) {
        Write-Host "The server presented a different certificate than the one this script was" -ForegroundColor Red
        Write-Host "generated for, so nothing was sent. Either something is intercepting the" -ForegroundColor Red
        Write-Host "connection, or the server's certificate changed (setup.sh --force, or a new" -ForegroundColor Red
        Write-Host "address). Get a freshly generated setupclient.ps1 from the server's scripts/." -ForegroundColor Red
        exit 1
    }
    if ($exitCode -ne 0) {
        Write-Host "Registration failed: curl exit $exitCode." -ForegroundColor Red
        WriteUnreachableHint
        exit 1
    }

    try { $parsed = ($output -join "`n") | ConvertFrom-Json }
    catch {
        Write-Host "The server's reply was not JSON: $output" -ForegroundColor Red
        exit 1
    }
    return $parsed
}

# The server only ever allocates .2 through .254 of its own /24.
function IsClientAddress($Address) {
    $pattern = '^' + [regex]::Escape($SubnetPrefix) + '\.([0-9]{1,3})$'
    if ("$Address" -match $pattern) {
        $last = [int]$Matches[1]
        return ($last -ge 2 -and $last -le 254)
    }
    return $false
}

# Mirrors generate_client_config() in auth/helpers.py, which clients rendered
# before this script built its own config still rely on. Keep all copies in
# step; helpers.py lists them.
function BuildClientConfig($PrivateKey, $Address) {
    $lines = @(
        "[Interface]"
        "PrivateKey = $PrivateKey"
        "Address = $Address/32"
        "DNS = $DnsServer"
        ""
        "[Peer]"
        "PublicKey = $ServerWgKey"
        "Endpoint = ${ServerPublicIp}:$ServerWgPort"
        "AllowedIPs = 0.0.0.0/0, ::/0"
        "PersistentKeepalive = 25"
    )
    return ($lines -join "`n") + "`n"
}

# Writes the config as plaintext into the store. The manager encrypts it to
# <name>.conf.dpapi on its next start, which is also what makes it appear in
# the GUI.
function WriteConfigToStore($Config, $Name) {
    $path   = Join-Path $StoreDir "$Name.conf"
    [System.IO.File]::WriteAllText($path, $Config, (New-Object System.Text.UTF8Encoding $false))

    # The manager runs as SYSTEM and has to read this to import it. The store
    # has inheritance disabled, so grant explicitly rather than assume.
    #
    # If the manager was already running it watches this directory, and it can
    # encrypt the file to <name>.conf.dpapi and delete the plaintext before we
    # get here. That is a completed import, not a failure -- so only set the
    # ACL if the file is still ours to set it on.
    if (Test-Path $path) {
        icacls $path /inheritance:r /grant:r "SYSTEM:(F)" /grant:r "Administrators:(F)" 2>$null | Out-Null
    }
    return $path
}

function ImportIntoManager($Name) {
    $dpapi = Join-Path $StoreDir "$Name.conf.dpapi"
    $plain = Join-Path $StoreDir "$Name.conf"

    # Migration from plaintext to DPAPI happens while the manager is starting,
    # so the file has to be in place before it comes up. Stop and start
    # explicitly rather than Restart-Service, and give it room.
    foreach ($attempt in 1..2) {
        Write-Host "Importing '$Name' into the WireGuard manager (attempt $attempt of 2)..." -ForegroundColor Cyan

        Stop-Service WireGuardManager -Force -ErrorAction SilentlyContinue
        Start-Sleep -Seconds 2
        try { Start-Service WireGuardManager -ErrorAction Stop }
        catch {
            Write-Host "Could not start WireGuardManager: $_" -ForegroundColor Red
            exit 1
        }

        for ($i = 0; $i -lt 20; $i++) {
            Start-Sleep -Seconds 1
            if (Test-Path $dpapi) { return $true }
        }

        # Neither form present means something removed the file outright.
        if (-not (Test-Path $plain)) { return $false }
    }

    # Still plaintext. The store is what the GUI enumerates, and it reads both
    # .conf and .conf.dpapi, so the tunnel is listed either way.
    return (Test-Path $plain)
}

function VerifyHandshake($Name) {
    Write-Host "Verifying handshake (up to 15s)..." -ForegroundColor Cyan
    $deadline = (Get-Date).AddSeconds(15)
    while ((Get-Date) -lt $deadline) {
        $line = & $WgExe show $Name latest-handshakes 2>$null | Select-Object -First 1
        if ($line) {
            $epoch = ($line -split '\s+')[-1]
            if ($epoch -match '^\d+$' -and [int64]$epoch -gt 0) { return $true }
        }
        Start-Sleep -Seconds 1
    }
    return $false
}

# WireGuard for Windows implements block-untunneled-traffic itself, triggered by
# the /0 AllowedIPs the server now sends for both address families. Writing our
# own WFP or firewall rules here would be a bad trade: WireGuard already does it
# correctly, and a wrong custom rule can lock someone out of their own network
# with no easy way back.
#
# What is worth doing is checking it actually took effect. Capturing both
# default routes is the precondition for that blocking, and a missing ::/0 route
# is the specific failure that silently leaks IPv6 while everything looks fine.
# This reports; it never fails the install.
function VerifyKillSwitch($Name) {
    $adapter = Get-NetAdapter -Name $Name -ErrorAction SilentlyContinue
    if (-not $adapter) {
        Write-Host "Could not find adapter '$Name' to verify routing." -ForegroundColor Yellow
        return
    }

    $v4 = @(Get-NetRoute -DestinationPrefix '0.0.0.0/0' -ErrorAction SilentlyContinue |
            Where-Object { $_.InterfaceIndex -eq $adapter.ifIndex })
    $v6 = @(Get-NetRoute -DestinationPrefix '::/0' -ErrorAction SilentlyContinue |
            Where-Object { $_.InterfaceIndex -eq $adapter.ifIndex })

    if ($v4.Count -gt 0 -and $v6.Count -gt 0) {
        Write-Host "Kill switch active: both IPv4 and IPv6 default routes are in the tunnel." -ForegroundColor Green
        return
    }

    if ($v4.Count -eq 0) {
        Write-Host "IPv4 traffic is NOT routed through the tunnel." -ForegroundColor Red
        Write-Host "Check the tunnel is active and AllowedIPs contains 0.0.0.0/0." -ForegroundColor Yellow
        return
    }

    # IPv4 captured, IPv6 not. Harmless if the machine has no IPv6 at all;
    # a live leak if it does, so say which case this is.
    $hasV6 = @(Get-NetIPAddress -AddressFamily IPv6 -ErrorAction SilentlyContinue |
               Where-Object { $_.PrefixOrigin -ne 'WellKnown' -and $_.InterfaceIndex -ne $adapter.ifIndex })
    if ($hasV6.Count -gt 0) {
        Write-Host "IPv6 is NOT routed through the tunnel and this machine has IPv6 addresses." -ForegroundColor Red
        Write-Host "IPv6 traffic would bypass the VPN. Confirm AllowedIPs contains ::/0," -ForegroundColor Yellow
        Write-Host "or disable IPv6 on your network adapter." -ForegroundColor Yellow
    } else {
        Write-Host "IPv4 routed through the tunnel; no IPv6 on this machine to route." -ForegroundColor Green
    }
}

Write-Host "=================================================" -ForegroundColor Cyan
Write-Host "   AUTOGUARD VPN CLIENT SETUP                   " -ForegroundColor Cyan
Write-Host "=================================================" -ForegroundColor Cyan

CheckWireGuard

# Before registering, not after. Every failure past this point has already cost
# the server an IP allocation and a peer file that nothing will ever claim --
# the auth API has no delete endpoint, so those leak permanently. Everything
# that can be checked without talking to the server gets checked here.
EnsureStore

# One stable tunnel name per server. The old script appended 2, 3, 4... on each
# run, so every failed attempt left another dead tunnel behind.
$existing = StorePathFor $InterfaceName
if ($existing) {
    Write-Host "Tunnel '$InterfaceName' is already in the WireGuard GUI." -ForegroundColor Green
    Write-Host "Open WireGuard and use Activate / Deactivate to toggle it." -ForegroundColor Green
    Write-Host ""
    Write-Host "To re-register from scratch, delete it in the GUI first, then re-run." -ForegroundColor Yellow
    Start-Process $WgGui
    exit 0
}

AssertRendered

Write-Host "Generating keypair..." -ForegroundColor Cyan
$Keys = GenerateKeypair

Write-Host "Registering with $ServerPublicIp..." -ForegroundColor Cyan
$Response = RegisterPeer -PublicKey $Keys.Public
if ($Response.status -ne "ok") {
    Write-Host "Server rejected: $($Response | ConvertTo-Json)" -ForegroundColor Red
    exit 1
}
if (-not (IsClientAddress $Response.ip)) {
    Write-Host "Server assigned an address outside $SubnetPrefix.0/24: '$($Response.ip)'" -ForegroundColor Red
    exit 1
}
Write-Host "Assigned IP: $($Response.ip)" -ForegroundColor Green

# Only now, with a working replacement config in hand. Tearing the old tunnel
# down before this point would leave the user with no VPN at all whenever
# registration failed -- a dead token or a closed port and they are stranded.
RemoveOrphanedTunnels

$Config    = BuildClientConfig -PrivateKey $Keys.Private -Address $Response.ip
$PlainPath = WriteConfigToStore -Config $Config -Name $InterfaceName

if (-not (ImportIntoManager $InterfaceName)) {
    Write-Host ""
    Write-Host "The config did not survive in the WireGuard store." -ForegroundColor Red
    Write-Host "Store contents:" -ForegroundColor Yellow
    Get-ChildItem $StoreDir -Force -ErrorAction SilentlyContinue |
        ForEach-Object { Write-Host ("  " + $_.Name) -ForegroundColor Yellow }
    exit 1
}

Write-Host "Tunnel '$InterfaceName' is now listed in the WireGuard GUI." -ForegroundColor Green

$StorePath = StorePathFor $InterfaceName
& $WgGui /installtunnelservice $StorePath
Start-Sleep -Seconds 3

if (-not (VerifyHandshake $InterfaceName)) {
    Write-Host ""
    Write-Host "Tunnel installed but the handshake never completed." -ForegroundColor Red
    Write-Host "Deactivating so it does not blackhole your internet." -ForegroundColor Yellow
    Stop-Service (ServiceNameFor $InterfaceName) -ErrorAction SilentlyContinue
    Write-Host ""
    Write-Host "The tunnel stays in the GUI, so you can retry with Activate." -ForegroundColor Yellow
    Write-Host "Check UDP $ServerWgPort is open to $ServerPublicIp, then on the server run:" -ForegroundColor Yellow
    Write-Host "  docker exec wireguard wg show wg0" -ForegroundColor Yellow
    Write-Host "Your peer pubkey: $($Keys.Public)" -ForegroundColor Yellow
    Start-Process $WgGui
    exit 1
}

Write-Host ""
VerifyKillSwitch $InterfaceName

Start-Process $WgGui
Write-Host ""
Write-Host "VPN '$InterfaceName' is connected and traffic is flowing." -ForegroundColor Green
Write-Host "While it is active, traffic that cannot go through the tunnel is blocked" -ForegroundColor Green
Write-Host "rather than falling back to your normal connection -- LAN access included." -ForegroundColor Green
Write-Host "Toggle it on and off with Activate / Deactivate in the WireGuard GUI." -ForegroundColor Green
