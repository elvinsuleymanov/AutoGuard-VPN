# This repo is authored on Windows but every shell script runs on a Linux host.
# Force LF so a CRLF checkout never reaches bash as `\r: command not found`.
*.sh            text eol=lf
*.sh.template   text eol=lf
*.conf          text eol=lf
*.conf.template text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
Dockerfile*     text eol=lf

*.ps1           text eol=crlf
*.ps1.template  text eol=crlf

*.png           binary
*.pem           binary
